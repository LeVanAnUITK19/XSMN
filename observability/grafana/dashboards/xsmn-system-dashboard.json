{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "XSMN Backend - System & HTTP Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🔍 OVERVIEW",
      "type": "row"
    },

    {
      "id": 1,
      "title": "Service Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"xsmn-backend\"}", "legendFormat": "Status", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "targets": [{ "expr": "time() - process_start_time_seconds{job=\"xsmn-backend\"}", "legendFormat": "Uptime", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 3,
      "title": "CPU Usage (Node Process)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 0.8 }] }
        }
      },
      "targets": [{ "expr": "rate(process_cpu_user_seconds_total{job=\"xsmn-backend\"}[1m]) + rate(process_cpu_system_seconds_total{job=\"xsmn-backend\"}[1m])", "legendFormat": "CPU", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 4,
      "title": "Process RSS Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200000000 }, { "color": "red", "value": 400000000 }] }
        }
      },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"xsmn-backend\"}", "legendFormat": "RSS", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 5,
      "title": "Heap Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 150000000 }, { "color": "red", "value": 300000000 }] }
        }
      },
      "targets": [{ "expr": "nodejs_heap_size_used_bytes{job=\"xsmn-backend\"}", "legendFormat": "Heap Used", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 6,
      "title": "Requests/sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\"}[1m]))", "legendFormat": "RPS", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 7,
      "title": "Error Rate (5xx %)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      },
      "targets": [{ "expr": "(sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_requests_total{job=\"xsmn-backend\"}[5m])) or vector(1)) * 100", "legendFormat": "5xx %", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 8,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] }
        }
      },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"xsmn-backend\"}[5m])) by (le))", "legendFormat": "P95", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "⚙️ SYSTEM",
      "type": "row"
    },

    {
      "id": 10,
      "title": "CPU Usage - Node.js Process (user + system)",
      "description": "CPU time consumed by the Node.js process only. Không phải toàn bộ CPU của Render host.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.8 }] }
        }
      },
      "targets": [
        { "expr": "rate(process_cpu_user_seconds_total{job=\"xsmn-backend\"}[1m])", "legendFormat": "User CPU", "refId": "A" },
        { "expr": "rate(process_cpu_system_seconds_total{job=\"xsmn-backend\"}[1m])", "legendFormat": "System CPU", "refId": "B" },
        { "expr": "rate(process_cpu_user_seconds_total{job=\"xsmn-backend\"}[1m]) + rate(process_cpu_system_seconds_total{job=\"xsmn-backend\"}[1m])", "legendFormat": "Total CPU", "refId": "C" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 11,
      "title": "Memory - Process RSS vs Heap",
      "description": "RSS = Resident Set Size (tổng RAM process dùng). Heap = bộ nhớ V8 JavaScript engine.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"xsmn-backend\"}", "legendFormat": "Process RSS", "refId": "A" },
        { "expr": "nodejs_heap_size_used_bytes{job=\"xsmn-backend\"}", "legendFormat": "Heap Used", "refId": "B" },
        { "expr": "nodejs_heap_size_total_bytes{job=\"xsmn-backend\"}", "legendFormat": "Heap Total", "refId": "C" },
        { "expr": "nodejs_external_memory_bytes{job=\"xsmn-backend\"}", "legendFormat": "External Memory", "refId": "D" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 12,
      "title": "Heap Usage %",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
        }
      },
      "targets": [{ "expr": "(nodejs_heap_size_used_bytes{job=\"xsmn-backend\"} / nodejs_heap_size_total_bytes{job=\"xsmn-backend\"}) * 100", "legendFormat": "Heap %", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 13,
      "title": "Event Loop Lag",
      "description": "Thời gian delay của Node.js event loop. Cao → process bị block.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.5 }] }
        }
      },
      "targets": [{ "expr": "nodejs_eventloop_lag_seconds{job=\"xsmn-backend\"}", "legendFormat": "Event Loop Lag", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 14,
      "title": "Active Handles & Requests",
      "description": "Handles = open sockets/timers/etc. Requests = in-flight I/O.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "nodejs_active_handles_total{job=\"xsmn-backend\"}", "legendFormat": "Active Handles", "refId": "A" },
        { "expr": "nodejs_active_requests_total{job=\"xsmn-backend\"}", "legendFormat": "Active Requests", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "🌐 HTTP TRAFFIC",
      "type": "row"
    },

    {
      "id": 20,
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 21 },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sum(http_requests_total{job=\"xsmn-backend\"})", "legendFormat": "Total", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 21,
      "title": "Requests/sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 21 },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\"}[1m]))", "legendFormat": "RPS", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 22,
      "title": "Active HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 21 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }
        }
      },
      "targets": [{ "expr": "sum(http_requests_in_progress{job=\"xsmn-backend\"})", "legendFormat": "In Progress", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 23,
      "title": "Incoming Traffic",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 21 },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [{ "expr": "sum(rate(http_request_bytes_total{job=\"xsmn-backend\"}[1m]))", "legendFormat": "Inbound", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 24,
      "title": "Outgoing Traffic",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 21 },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [{ "expr": "sum(rate(http_response_bytes_total{job=\"xsmn-backend\"}[1m]))", "legendFormat": "Outbound", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 25,
      "title": "Requests by HTTP Method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",method=\"GET\"}[1m]))", "legendFormat": "GET", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",method=\"POST\"}[1m]))", "legendFormat": "POST", "refId": "B" },
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",method=\"PUT\"}[1m]))", "legendFormat": "PUT", "refId": "C" },
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",method=\"DELETE\"}[1m]))", "legendFormat": "DELETE", "refId": "D" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 26,
      "title": "Requests by Status Code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"2..\"}[1m]))", "legendFormat": "2xx", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"4..\"}[1m]))", "legendFormat": "4xx", "refId": "B" },
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"5..\"}[1m]))", "legendFormat": "5xx", "refId": "C" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 27,
      "title": "Traffic (Inbound vs Outbound)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(http_request_bytes_total{job=\"xsmn-backend\"}[1m]))", "legendFormat": "Inbound (req)", "refId": "A" },
        { "expr": "sum(rate(http_response_bytes_total{job=\"xsmn-backend\"}[1m]))", "legendFormat": "Outbound (res)", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 103,
      "title": "⏱️ LATENCY",
      "type": "row"
    },

    {
      "id": 30,
      "title": "Response Time Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"xsmn-backend\"}[5m])) by (le))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{job=\"xsmn-backend\"}[5m])) by (le))", "legendFormat": "P90", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"xsmn-backend\"}[5m])) by (le))", "legendFormat": "P95", "refId": "C" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"xsmn-backend\"}[5m])) by (le))", "legendFormat": "P99", "refId": "D" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 31,
      "title": "Average Response Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_sum{job=\"xsmn-backend\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"xsmn-backend\"}[5m]))", "legendFormat": "Avg Latency", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 32,
      "title": "Latency by Route (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 3 } } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"xsmn-backend\",route=~\"$route\"}[5m])) by (le, route))", "legendFormat": "{{route}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "id": 104,
      "title": "🚨 ERRORS",
      "type": "row"
    },

    {
      "id": 40,
      "title": "5xx Error Rate %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }] }
        }
      },
      "targets": [{ "expr": "(sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_requests_total{job=\"xsmn-backend\"}[5m])) or vector(1)) * 100", "legendFormat": "5xx Error Rate %", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 41,
      "title": "4xx vs 5xx Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 59 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"4..\"}[5m]))", "legendFormat": "4xx/sec", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{job=\"xsmn-backend\",status_code=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 67 },
      "id": 105,
      "title": "📊 ENDPOINTS",
      "type": "row"
    },

    {
      "id": 50,
      "title": "Most Requested Endpoints",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 68 },
      "options": { "sortBy": [{ "displayName": "Requests/sec", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [{ "matcher": { "id": "byName", "options": "Requests/sec" }, "properties": [{ "id": "unit", "value": "reqps" }, { "id": "custom.width", "value": 150 }] }]
      },
      "targets": [{
        "expr": "sort_desc(sum(rate(http_requests_total{job=\"xsmn-backend\"}[5m])) by (route, method))",
        "legendFormat": "{{method}} {{route}}",
        "refId": "A",
        "instant": true,
        "format": "table"
      }],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "Value": "Requests/sec", "route": "Route", "method": "Method" } } }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 51,
      "title": "Slowest Endpoints (P95)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 68 },
      "options": { "sortBy": [{ "displayName": "P95 Latency", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
