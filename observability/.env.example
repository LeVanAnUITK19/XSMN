# ============================================================
# observability/.env.example
# Copy thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# ============================================================

# Host:port của backend (KHÔNG có http:// hoặc https://)
# Local Mac/Windows: host.docker.internal:3000
# Local Linux:       172.17.0.1:3000
# Render:            your-backend-name.onrender.com
BACKEND_TARGET=host.docker.internal:3000

# Token bảo vệ /metrics endpoint
# Để trống = không cần auth (local dev)
# Tạo token: openssl rand -hex 32
METRICS_TOKEN=

# Grafana credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# URL đầy đủ của Prometheus để Grafana kết nối
# Local Docker Compose: http://prometheus:9090
# Render:               https://your-prometheus-name.onrender.com
GF_PROMETHEUS_URL=http://prometheus:9090

# Thời gian Prometheus giữ data
PROMETHEUS_RETENTION=7d
