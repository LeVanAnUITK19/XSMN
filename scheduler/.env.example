# ============================================================
# XSMN Scheduler — Environment Variables
# Copy file này thành .env để chạy local
# KHÔNG commit file .env vào git
# ============================================================

# Node environment
NODE_ENV=production

# Timezone — bắt buộc để tính ngày VN đúng
TZ=Asia/Ho_Chi_Minh

# ── Backend API ──────────────────────────────────────────────────
# URL gốc của backend (không có trailing slash)
# Production: https://xsmn-1.onrender.com
# Local dev:  http://localhost:3000
BACKEND_BASE_URL=https://xsmn-1.onrender.com

# Token xác thực để gọi API ghi kết quả
# Phải khớp với SCHEDULER_API_TOKEN được cấu hình trên backend
# Tạo token: openssl rand -hex 32
SCHEDULER_API_TOKEN=

# ── HTTP Settings ────────────────────────────────────────────────
# Timeout cho mỗi HTTP request (ms)
HTTP_TIMEOUT_MS=60000

# ── Crawl Settings ───────────────────────────────────────────────
# Số lần retry tối đa khi crawl thất bại
CRAWL_RETRY_LIMIT=3

# ── Lịch làm việc (giờ Việt Nam, format HH:MM) ──────────────────
# Render Cron Job khởi chạy scheduler lúc 09:05 UTC (= 16:05 VN)
# Scheduler tự chạy vòng lặp kiểm tra trong cửa sổ này
JOB_WINDOW_START=16:05
JOB_WINDOW_END=17:30

# Khoảng cách giữa các lượt kiểm tra (giây)
# 300s = 5 phút
CHECK_INTERVAL_SECONDS=300

# ── Region ───────────────────────────────────────────────────────
REGION=mien-nam
